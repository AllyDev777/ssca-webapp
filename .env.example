# Copy to .env.local (dev) or set as host environment variables (production).
# Never commit real values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ssca_app
DB_PASSWORD=change-me
DB_NAME=ssca
# Max pooled connections (optional, default 10)
DB_POOL_SIZE=10
# Signs the role-hint cookie used by middleware. 32+ random chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Only when serving under a sub-path such as example.org/ssca (leave unset for a subdomain):
# NEXT_PUBLIC_BASE_PATH=/ssca

# --- Forgot-password emails (optional; without SMTP_HOST the reset page asks members to contact an admin) ---
# After filling these in, check them with: npm run test-email -- you@example.com
# Public address of the app, used to build the link in the email (no trailing slash).
APP_URL=http://localhost:3000
# SMTP server. Port 465 = SSL/TLS (SMTP_SECURE=true); 587 = STARTTLS (SMTP_SECURE=false).
# Hostinger email: smtp.hostinger.com, 465, true.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to members. Defaults to SMTP_USER.
MAIL_FROM=SSCA <no-reply@example.org>
