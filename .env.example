# Copy to .env.local (dev) or set as host environment variables (production).
# Never commit real values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ssca_app
DB_PASSWORD=change-me
DB_NAME=ssca
# Max pooled connections (optional, default 10)
DB_POOL_SIZE=10
# Signs the role-hint cookie used by middleware. 32+ random chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Only when serving under a sub-path such as example.org/ssca (leave unset for a subdomain):
# NEXT_PUBLIC_BASE_PATH=/ssca
